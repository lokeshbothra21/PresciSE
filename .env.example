# ── Required ────────────────────────────────────────────────────────────────
# Gemini API key. Get one at https://aistudio.google.com/apikey
# If absent, the app runs in MOCK mode (returns canned answers).
GEMINI_API_KEY=your_api_key_here

# ── Auth / environment ───────────────────────────────────────────────────────
# Service auth. If set, every endpoint requires header  X-API-Key: <this value>.
# Leave empty for local dev (open). MUST be set when PRESCISE_ENV != local.
PRESCISE_API_KEY=

# local | production. Non-local + empty PRESCISE_API_KEY → endpoints fail closed.
PRESCISE_ENV=local

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite by default; point at Postgres for deployment (same models).
PRESCISE_DATABASE_URL=sqlite:///data/prescise.db
# PRESCISE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/prescise

# ── Paths / limits / CORS ────────────────────────────────────────────────────
PRESCISE_DATA_DIR=data
PRESCISE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000   # '*' = allow all
PRESCISE_MAX_UPLOAD_MB=50
PRESCISE_MAX_QUERY_LEN=512

# ── LLM ──────────────────────────────────────────────────────────────────────
PRESCISE_RATE_LIMIT=60        # Gemini requests/min (raise on a paid tier)

# ── Optional / formula pipeline ──────────────────────────────────────────────
PRESCISE_ENABLE_VLM_BACKGROUND_SCAN=0   # Nougat scan (off; incompatible w/ transformers 5.x)
PRESCISE_FORMULA_QUALITY_MODE=balanced  # balanced | fast | accurate
